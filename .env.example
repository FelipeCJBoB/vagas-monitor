# Copie para .env e preencha só o que for usar. Sem nada preenchido, o monitor
# ainda gera os relatórios Markdown/HTML — só não notifica.

# --- Telegram (opcional) -----------------------------------------------
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token.
# 2) Envie qualquer mensagem para o seu bot.
# 3) Rode: python -m vagas_monitor setup-telegram   (descobre e grava o chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail via Gmail (opcional) -----------------------------------------
# Gere uma "senha de app" em https://myaccount.google.com/apppasswords (exige 2FA).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=felipefilipi1213@gmail.com
SMTP_PASSWORD=
EMAIL_TO=felipefilipi1213@gmail.com

# --- Avaliação por IA (opcional) -----------------------------------------
# Com uma das chaves, as melhores vagas novas recebem nota 0-10 e um comentário.
# `avaliacao.provedor: auto` no config.yaml usa a primeira que encontrar,
# preferindo o Gemini por ter nível gratuito.
#
# Gemini: chave gratuita em https://aistudio.google.com/apikey
#   A assinatura Gemini Pro NÃO dá a chave; ela vem do AI Studio e independe
#   de assinatura. No nível gratuito o Google pode usar os dados para treinar.
GEMINI_API_KEY=
#
# Anthropic: pré-paga, exige crédito em https://console.anthropic.com
ANTHROPIC_API_KEY=
